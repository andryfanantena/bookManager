# === À ajouter dans votre fichier .env ===

# Clé API Google Books facultative (la recherche ISBN fonctionne sans clé).
GOOGLE_BOOKS_API_KEY=

# API SRU publique de Gallica (Bibliothèque nationale de France).
GALLICA_API_URL=https://gallica.bnf.fr/SRU

# N'oublie pas que le disque "public" doit être lié :
# php artisan storage:link
FILESYSTEM_DISK=public
